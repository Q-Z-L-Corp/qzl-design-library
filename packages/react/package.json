{
  "name": "@qzlcorp/react",
  "version": "0.2.0",
  "description": "React components for Web applications in QZL Design Library.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Q-Z-L-Corp/qzl-design-library.git",
    "directory": "packages/react"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/components",
    "src/styles.css",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@qzlcorp/core": "workspace:*",
    "@qzlcorp/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "jsdom": "31.0.1",
    "vitest": "5.1.0"
  }
}
